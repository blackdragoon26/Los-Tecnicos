{"allContent":{"docusaurus-plugin-content-docs":{"default":{"loadedVersions":[{"versionName":"current","label":"Next","banner":null,"badge":false,"noIndex":false,"className":"docs-version-current","path":"/","tagsPath":"/tags","editUrl":"https://github.com/blackdragoon26/Los-Tecnicos/tree/main/docs/docs","editUrlLocalized":"https://github.com/blackdragoon26/Los-Tecnicos/tree/main/docs/i18n/en/docusaurus-plugin-content-docs/current","isLast":true,"routePriority":-1,"sidebarFilePath":"/Users/shanks/Documents/Projects/stellarHackathon/Los-Tecnicos/docs/sidebars.js","contentPath":"/Users/shanks/Documents/Projects/stellarHackathon/Los-Tecnicos/docs/docs","contentPathLocalized":"/Users/shanks/Documents/Projects/stellarHackathon/Los-Tecnicos/docs/i18n/en/docusaurus-plugin-content-docs/current","docs":[{"id":"algorithms/dynamic-pricing","title":"Dynamic Pricing Engine","description":"The pricing engine calculates a fair, real-time price for every energy trade. It replaces arbitrary utility tariffs with a multi-factor model driven by actual market conditions. The coefficients can be adjusted by community governance.","source":"@site/docs/algorithms/dynamic-pricing.md","sourceDirName":"algorithms","slug":"/algorithms/dynamic-pricing","permalink":"/algorithms/dynamic-pricing","draft":false,"unlisted":false,"editUrl":"https://github.com/blackdragoon26/Los-Tecnicos/tree/main/docs/docs/algorithms/dynamic-pricing.md","tags":[],"version":"current","frontMatter":{"id":"dynamic-pricing","title":"Dynamic Pricing Engine","sidebar_label":"Dynamic Pricing"},"sidebar":"docs","previous":{"title":"Business Flow","permalink":"/architecture/business-flow"},"next":{"title":"Matching Engine","permalink":"/algorithms/matching-engine"}},{"id":"algorithms/matching-engine","title":"Matching Engine","description":"The matching engine runs as a background goroutine that polls for compatible buy and sell orders every 5 seconds. When a match is found, it sequences through price calculation, ZK verification, database settlement, IoT notification, and Soroban execution — all within a single atomic transaction.","source":"@site/docs/algorithms/matching-engine.md","sourceDirName":"algorithms","slug":"/algorithms/matching-engine","permalink":"/algorithms/matching-engine","draft":false,"unlisted":false,"editUrl":"https://github.com/blackdragoon26/Los-Tecnicos/tree/main/docs/docs/algorithms/matching-engine.md","tags":[],"version":"current","frontMatter":{"id":"matching-engine","title":"Matching Engine","sidebar_label":"Matching Engine"},"sidebar":"docs","previous":{"title":"Dynamic Pricing","permalink":"/algorithms/dynamic-pricing"},"next":{"title":"Zero-Knowledge Proofs","permalink":"/algorithms/zero-knowledge"}},{"id":"algorithms/zero-knowledge","title":"Zero-Knowledge Proofs","description":"Sellers prove they have sufficient battery capacity to fulfill an order — without revealing the exact battery percentage. The matching engine verifies this claim before executing any trade.","source":"@site/docs/algorithms/zero-knowledge.md","sourceDirName":"algorithms","slug":"/algorithms/zero-knowledge","permalink":"/algorithms/zero-knowledge","draft":false,"unlisted":false,"editUrl":"https://github.com/blackdragoon26/Los-Tecnicos/tree/main/docs/docs/algorithms/zero-knowledge.md","tags":[],"version":"current","frontMatter":{"id":"zero-knowledge","title":"Zero-Knowledge Proofs","sidebar_label":"Zero-Knowledge Proofs"},"sidebar":"docs","previous":{"title":"Matching Engine","permalink":"/algorithms/matching-engine"},"next":{"title":"Overview","permalink":"/iot/iot-overview"}},{"id":"api/api-overview","title":"API Reference","description":"The Stelltron backend exposes a REST API built on Go/Gin. All protected endpoints require a Bearer JWT token in the Authorization header.","source":"@site/docs/api/overview.md","sourceDirName":"api","slug":"/api/api-overview","permalink":"/api/api-overview","draft":false,"unlisted":false,"editUrl":"https://github.com/blackdragoon26/Los-Tecnicos/tree/main/docs/docs/api/overview.md","tags":[],"version":"current","frontMatter":{"id":"api-overview","title":"API Reference","sidebar_label":"Overview"},"sidebar":"docs","previous":{"title":"DeFi Protocol","permalink":"/defi/defi-overview"}},{"id":"architecture/business-flow","title":"Business Flow","description":"A complete walkthrough of the Stelltron business model — from solar production to settled trade to revenue distribution.","source":"@site/docs/architecture/business-flow.md","sourceDirName":"architecture","slug":"/architecture/business-flow","permalink":"/architecture/business-flow","draft":false,"unlisted":false,"editUrl":"https://github.com/blackdragoon26/Los-Tecnicos/tree/main/docs/docs/architecture/business-flow.md","tags":[],"version":"current","frontMatter":{"id":"business-flow","title":"Business Flow","sidebar_label":"Business Flow"},"sidebar":"docs","previous":{"title":"System Overview","permalink":"/architecture/system-overview"},"next":{"title":"Dynamic Pricing","permalink":"/algorithms/dynamic-pricing"}},{"id":"architecture/system-overview","title":"System Architecture","description":"Stelltron is a full-stack application spanning physical hardware, an IoT communication layer, a Go backend, a Next.js frontend, and four Soroban smart contracts on Stellar. Every layer has a defined contract with the layers above and below it.","source":"@site/docs/architecture/system-overview.md","sourceDirName":"architecture","slug":"/architecture/system-overview","permalink":"/architecture/system-overview","draft":false,"unlisted":false,"editUrl":"https://github.com/blackdragoon26/Los-Tecnicos/tree/main/docs/docs/architecture/system-overview.md","tags":[],"version":"current","frontMatter":{"id":"system-overview","title":"System Architecture","sidebar_label":"System Overview"},"sidebar":"docs","previous":{"title":"Quickstart","permalink":"/getting-started/quickstart"},"next":{"title":"Business Flow","permalink":"/architecture/business-flow"}},{"id":"contracts/contracts-overview","title":"Smart Contracts","description":"Stelltron deploys four Soroban contracts on the Stellar testnet, written in Rust and compiled to WASM. All contracts are under 200 lines each, intentionally lean — on-chain storage is expensive, so the Soroban contracts handle token accounting and governance, while the Go backend handles order books and matching logic.","source":"@site/docs/contracts/overview.md","sourceDirName":"contracts","slug":"/contracts/contracts-overview","permalink":"/contracts/contracts-overview","draft":false,"unlisted":false,"editUrl":"https://github.com/blackdragoon26/Los-Tecnicos/tree/main/docs/docs/contracts/overview.md","tags":[],"version":"current","frontMatter":{"id":"contracts-overview","title":"Smart Contracts","sidebar_label":"Overview"},"sidebar":"docs","previous":{"title":"Overview","permalink":"/iot/iot-overview"},"next":{"title":"DeFi Protocol","permalink":"/defi/defi-overview"}},{"id":"defi/defi-overview","title":"DeFi Protocol","description":"Stelltron builds a DeFi layer on top of physical energy trading. Participants earn yield by providing liquidity, borrowing tokens for arbitrage, and capturing trade commissions.","source":"@site/docs/defi/overview.md","sourceDirName":"defi","slug":"/defi/defi-overview","permalink":"/defi/defi-overview","draft":false,"unlisted":false,"editUrl":"https://github.com/blackdragoon26/Los-Tecnicos/tree/main/docs/docs/defi/overview.md","tags":[],"version":"current","frontMatter":{"id":"defi-overview","title":"DeFi Protocol","sidebar_label":"DeFi Protocol"},"sidebar":"docs","previous":{"title":"Overview","permalink":"/contracts/contracts-overview"},"next":{"title":"Overview","permalink":"/api/api-overview"}},{"id":"getting-started/quickstart","title":"Getting Started","description":"This guide walks through running the full Stelltron stack locally: smart contracts on Stellar testnet, Go backend, and Next.js frontend.","source":"@site/docs/getting-started/quickstart.md","sourceDirName":"getting-started","slug":"/getting-started/quickstart","permalink":"/getting-started/quickstart","draft":false,"unlisted":false,"editUrl":"https://github.com/blackdragoon26/Los-Tecnicos/tree/main/docs/docs/getting-started/quickstart.md","tags":[],"version":"current","frontMatter":{"id":"quickstart","title":"Getting Started","sidebar_label":"Quickstart"},"sidebar":"docs","previous":{"title":"Overview","permalink":"/"},"next":{"title":"System Overview","permalink":"/architecture/system-overview"}},{"id":"intro","title":"Stelltron","description":"Peer-to-peer solar energy trading on the Stellar blockchain.","source":"@site/docs/intro.md","sourceDirName":".","slug":"/","permalink":"/","draft":false,"unlisted":false,"editUrl":"https://github.com/blackdragoon26/Los-Tecnicos/tree/main/docs/docs/intro.md","tags":[],"version":"current","frontMatter":{"id":"intro","title":"Stelltron","sidebar_label":"Overview","slug":"/"},"sidebar":"docs","next":{"title":"Quickstart","permalink":"/getting-started/quickstart"}},{"id":"iot/iot-overview","title":"IoT Layer","description":"The physical layer consists of ESP32 microcontrollers managing actual battery-to-battery energy transfer, orchestrated by a Raspberry Pi 4B acting as a local edge gateway. The Pi handles bidirectional communication between the hardware relay circuit and the cloud backend.","source":"@site/docs/iot/overview.md","sourceDirName":"iot","slug":"/iot/iot-overview","permalink":"/iot/iot-overview","draft":false,"unlisted":false,"editUrl":"https://github.com/blackdragoon26/Los-Tecnicos/tree/main/docs/docs/iot/overview.md","tags":[],"version":"current","frontMatter":{"id":"iot-overview","title":"IoT Layer","sidebar_label":"Overview"},"sidebar":"docs","previous":{"title":"Zero-Knowledge Proofs","permalink":"/algorithms/zero-knowledge"},"next":{"title":"Overview","permalink":"/contracts/contracts-overview"}}],"drafts":[],"sidebars":{"docs":[{"type":"doc","id":"intro","label":"Overview","translatable":true},{"type":"category","